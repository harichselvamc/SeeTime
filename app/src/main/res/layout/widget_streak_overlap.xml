<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_streak_overlap_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:padding="12dp">

    <!-- Header: Flame Streak & Freeze status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_flame_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_widget_fire"
            android:contentDescription="Streak Flame" />

        <TextView
            android:id="@+id/widget_streak_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="0 Days"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_freeze_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip_flame"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="Active"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:background="#26FFFFFF" />

    <!-- Overlap Info Card -->
    <LinearLayout
        android:id="@+id/widget_overlap_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/widget_card_elevated"
        android:padding="8dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_overlap_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_widget_overlap"
                android:contentDescription="Overlap Status" />

            <TextView
                android:id="@+id/widget_overlap_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Overlap Status"
                android:textColor="#81C784"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_overlap_subtext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Select timezone pair in app"
            android:textColor="#CAC4D0"
            android:textSize="11sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Footer action -->
    <TextView
        android:id="@+id/widget_action_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Tap to log today's time"
        android:textColor="#D0BCFF"
        android:textSize="10sp"
        android:textStyle="bold" />

</LinearLayout>
