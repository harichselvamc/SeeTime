<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quick_log_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:gravity="center"
    android:padding="6dp">

    <ImageView
        android:id="@+id/widget_quick_flame_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_widget_fire"
        android:contentDescription="Streak Flame" />

    <TextView
        android:id="@+id/widget_quick_streak_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="0d"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_quick_log_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="+ Log"
        android:textColor="#D0BCFF"
        android:textSize="10sp"
        android:textStyle="bold" />

</LinearLayout>
